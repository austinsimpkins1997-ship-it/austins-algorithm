{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chronorealm:future-reader:timeline:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frame", "claims", "order"],
  "properties": {
    "schema_version": {"const": 1},
    "frame": {"$ref": "#/$defs/id"},
    "claims": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/claim"}},
    "order": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1200},
    "time": {
      "type": ["null", "object"], "additionalProperties": false,
      "required": ["from", "to", "clock"],
      "properties": {"from": {"type": "string", "format": "date-time"}, "to": {"type": "string", "format": "date-time"}, "clock": {"$ref": "#/$defs/id"}}
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "topic", "title", "kind", "value", "source", "times", "audience", "domain", "scope", "frame", "units", "dependencies", "next_check"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "topic": {"$ref": "#/$defs/id"}, "parent": {"$ref": "#/$defs/id"},
        "title": {"$ref": "#/$defs/text"}, "domain": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"},
        "frame": {"$ref": "#/$defs/text"}, "units": {"$ref": "#/$defs/text"}, "next_check": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["OBSERVATION", "REPORTED_OBSERVATION", "INFERENCE", "CALCULATION", "SIMULATION", "FORECAST", "HYPOTHESIS", "VERIFIED_FULFILLMENT"]},
        "value": {
          "type": "object", "required": ["status"], "additionalProperties": false,
          "properties": {"status": {"enum": ["KNOWN", "ESTIMATE", "UNKNOWN", "NOT_APPLICABLE", "CONTRADICTION"]}, "value": {"$ref": "#/$defs/text"}, "basis": {"$ref": "#/$defs/text"}},
          "allOf": [
            {"if": {"properties": {"status": {"enum": ["KNOWN", "ESTIMATE"]}}}, "then": {"required": ["value"]}, "else": {"not": {"required": ["value"]}}},
            {"if": {"properties": {"status": {"not": {"const": "KNOWN"}}}}, "then": {"required": ["basis"]}}
          ]
        },
        "source": {
          "type": "object", "required": ["title", "actor", "version"], "additionalProperties": false,
          "properties": {"title": {"$ref": "#/$defs/text"}, "actor": {"$ref": "#/$defs/text"}, "version": {"$ref": "#/$defs/text"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}
        },
        "times": {
          "type": "object", "required": ["event", "recorded", "available", "valid"], "additionalProperties": false,
          "properties": {"event": {"$ref": "#/$defs/time"}, "recorded": {"$ref": "#/$defs/time"}, "available": {"$ref": "#/$defs/time"}, "valid": {"$ref": "#/$defs/time"}}
        },
        "audience": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"anyOf": [{"const": "*"}, {"$ref": "#/$defs/id"}]}},
        "dependencies": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "context": {
          "type": "object",
          "propertyNames": {"enum": ["method", "calibration", "model_version", "assumptions", "acceptance", "alternatives", "conditions", "reproduction", "decision_dependencies"]},
          "additionalProperties": {"$ref": "#/$defs/text"}
        }
      }
    },
    "edge": {
      "type": "object", "required": ["from", "to", "relation", "evidence"], "additionalProperties": false,
      "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "evidence": {"$ref": "#/$defs/id"}, "relation": {"enum": ["causal", "temporal", "adjacent", "disputed"]}}
    }
  }
}
