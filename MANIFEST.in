include README.md GETTING_STARTED.md LICENSE NOTICE.md CHANGELOG.md CITATION.cff
include CONTRIBUTING.md EXTENDING.md ADAPTERS.md ROADMAP.md SECURITY.md USE_CASES.md
include IBM_MODEL_RESEARCH.md
include CONSTRAINT_WORKFLOW.md
recursive-include .github/workflows *.yml
recursive-include circuits *.qasm
recursive-include examples *.py
include examples/field_sensor_kit.json examples/site_interlock.json examples/telemetry_power.json
include examples/smoke-regression/constraint.json examples/smoke-regression/manifest.json examples/smoke-regression/requirements.txt
include examples/smoke-regression/baseline/request.json examples/smoke-regression/baseline/report.json
include examples/smoke-regression/baseline/selected.qasm examples/smoke-regression/baseline/receipt.json
include examples/diffuser-smoke-regression/constraint.json examples/diffuser-smoke-regression/manifest.json
include examples/diffuser-smoke-regression/baseline/request.json examples/diffuser-smoke-regression/baseline/report.json
include examples/diffuser-smoke-regression/baseline/receipt.json
include examples/diffuser-smoke-regression/manifest-native.json
include examples/diffuser-smoke-regression/baseline-native/request.json examples/diffuser-smoke-regression/baseline-native/report.json
include examples/diffuser-smoke-regression/baseline-native/receipt.json
include examples/placement-smoke-regression/baseline/request.json examples/placement-smoke-regression/baseline/report.json
include examples/placement-smoke-regression/baseline/receipt.json
recursive-include tests *.py
prune .build
prune build
prune dist
prune .venv
prune .pytest_cache
global-exclude __pycache__ *.py[cod] *.sqlite *.sqlite3 *.db *.log
