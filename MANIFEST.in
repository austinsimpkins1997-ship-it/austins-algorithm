include README.md GETTING_STARTED.md LICENSE NOTICE.md CHANGELOG.md CITATION.cff
include CONTRIBUTING.md EXTENDING.md ADAPTERS.md ROADMAP.md SECURITY.md USE_CASES.md
include IBM_MODEL_RESEARCH.md
include CONSTRAINT_WORKFLOW.md
recursive-include .github/workflows *.yml
recursive-include circuits *.qasm
recursive-include examples *.py
include examples/field_sensor_kit.json examples/site_interlock.json examples/telemetry_power.json
